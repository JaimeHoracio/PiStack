{
    "name": "pistack",
    "version": "0.0.15",
    "description": "PiStack - Agent Harness para PI (Orquestador con machine states, 3 niveles, MCP, skills curadas)",
    "type": "module",
    "main": "dist/cli.js",
    "bin": {
        "pistack": "dist/cli.js"
    },
    "files": [
        "dist/",
        "assets/",
        "manifest.json"
    ],
    "scripts": {
        "build": "bun build src/cli.ts --outdir dist --target bun",
        "build:installer": "bun build src/pistack-installer.ts --outdir dist --target bun",
        "build:controller": "bun build assets/tools/pistack-controller/src/index.js --outfile assets/tools/pistack-controller/index.js --target node",
        "generate-manifest": "bun run scripts/generate-manifest.ts",
        "prepare": "npm run build && npm run build:installer && npm run build:controller && npm run generate-manifest",
        "test:install": "bun run dist/cli.js install /tmp/pistack-test",
        "test:uninstall": "bun run dist/cli.js uninstall /tmp/pistack-test"
    },
    "keywords": [
        "pi",
        "pi-coding-agent",
        "agent-harness",
        "orchestrator"
    ],
    "author": "Jaime Horacio",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JaimeHoracio/PiStack.git"
    },
    "bugs": {
        "url": "https://github.com/JaimeHoracio/PiStack/issues"
    },
    "homepage": "https://github.com/JaimeHoracio/PiStack#readme",
    "engines": {
        "bun": ">=1.0.0"
    },
    "devDependencies": {
        "@earendil-works/pi-coding-agent": "^0.84.1",
        "@earendil-works/pi-ai": "^0.84.1",
        "@modelcontextprotocol/server": "^2.0.0",
        "@opencode-ai/sdk": "^1.18.15",
        "bun-types": "latest",
        "zod": "^4.4.3"
    }
}
